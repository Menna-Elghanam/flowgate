{
  "name": "flowgate",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @flowgate/workflow build && concurrently -n workflow,api,web -c blue,green,magenta \"pnpm --filter @flowgate/workflow dev\" \"pnpm --filter @flowgate/api dev\" \"pnpm --filter @flowgate/web dev\"",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @flowgate/web test:e2e",
    "db:migrate": "pnpm --filter @flowgate/api db:migrate",
    "db:seed": "pnpm --filter @flowgate/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.30.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.36.0"
  }
}
