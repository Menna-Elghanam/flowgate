NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://flowgate:flowgate@localhost:5441/flowgate
REDIS_URL=redis://localhost:6380

# Where the web app runs: used for CORS and for links in emails.
WEB_ORIGIN=http://localhost:3000

# Mailpit catches all emails locally: open http://localhost:8026
SMTP_HOST=localhost
SMTP_PORT=1026
MAIL_FROM=Flowgate <no-reply@flowgate.local>

SESSION_TTL_DAYS=30
COOKIE_SECURE=false

# Run the background worker (emails, deadline sweep) inside the API process.
# In production, set this to false and run `pnpm start:worker` as a separate process.
RUN_WORKER=true
SWEEP_INTERVAL_MS=60000

# Max login/sign-up attempts per IP per minute.
AUTH_RATE_LIMIT=10
